# Copy to .env, or fill in the DeepSeek settings in the application.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=120

# Notion Internal connection: share the parent page with the connection.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_AUTO_SYNC=false
